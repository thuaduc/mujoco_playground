<mujoco model="robco">
  <compiler angle="radian"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <joint damping="4.0" armature="0.026"/>
    <general dyntype="none" biastype="affine"/>
  </default>
  
  <asset>
    <!-- Textures and materials for the ground plane -->
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
    
    <!-- Robot mesh assets -->
    <mesh name="BD116_proximal_part_convdec" content_type="model/stl" file="assets/BD116_proximal_part_convdec.stl"/>
    <mesh name="BD116_distal_part_convdec" content_type="model/stl" file="assets/BD116_distal_part_convdec.stl"/> 
    <mesh name="C116_convdec" content_type="model/stl" file="assets/C116_convdec.stl"/> 
    <mesh name="D116-876.0002-G-proximal_convdec" content_type="model/stl" file="assets/D116-876.0002-G-proximal_convdec.stl"/>
    <mesh name="D116-876.0002-G-distal_convdec" content_type="model/stl" file="assets/D116-876.0002-G-distal_convdec.stl"/> 
    <mesh name="L116-500_convdec" content_type="model/stl" file="assets/L116-500_convdec.stl"/> 
    <mesh name="C86_convdec" content_type="model/stl" file="assets/C86_convdec.stl"/>  
    <mesh name="D86-876.0001-H-proximal_convdec" content_type="model/stl" file="assets/D86-876.0001-H-proximal_convdec.stl"/> 
    <mesh name="D86-876.0001-H-distal_convdec" content_type="model/stl" file="assets/D86-876.0001-H-distal_convdec.stl"/> 
    <mesh name="I86-400_convdec" content_type="model/stl" file="assets2/I86-400_convdec.stl"/> 
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 4" dir="0 0 -1"/>
    <light directional="true" ambient="0.1 0.1 0.1" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="2 2 3" dir="-1 -1 -1"/>
    
    <!-- Ground plane -->
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="matplane"/>
    <geom type="mesh" mesh="BD116_proximal_part_convdec" contype="0" conaffinity="0"/>
    <geom name="joint0_collision" type="box" size="0.15 0.15 0.15" pos="0 0 0" rgba="1 0 0 0.3" contype="1" conaffinity="1"/> <!-- red -->
    <!-- Target object for reaching task -->
    <body name="target" pos="0.5 0 1.2" mocap="true">
      <geom type="sphere" size="0.05" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>
    <body name="joint0_distal" pos="0 0 0.1887">
      <inertial pos="0.00621845 0.000265818 0.0535059" quat="0.73903 0.0245332 0.0293139 0.672587" mass="4.1622" diaginertia="0.0429894 0.042189 0.00873913"/>
      <joint name="joint0_joint" pos="0 0 0" axis="0 0 1" range="-4.7124 4.7124"/>
      <geom type="mesh" mesh="BD116_distal_part_convdec" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="C116_convdec" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="D116-876.0002-G-proximal_convdec" contype="0" conaffinity="0"/>
      <body name="joint1_distal" pos="0.0702 0 0.082" quat="0 0.707107 0 0.707107">
        <inertial pos="0.106613 0.185781 0.0844217" quat="0.230033 0.593444 -0.414361 0.650549" mass="4.74208" diaginertia="0.528787 0.386972 0.222957"/>
        <joint name="joint1_joint" pos="0 0 0" axis="0 0 1" range="-4.7124 4.7124"/>
        <geom type="mesh" mesh="D116-876.0002-G-distal_convdec" contype="0" conaffinity="0"/>
        <geom type="mesh" mesh="C116_convdec" contype="0" conaffinity="0"/>
        <geom type="mesh" mesh="L116-500_convdec" contype="0" conaffinity="0"/>
        <geom name="joint1_collision" type="sphere" size="0.1 0.1" pos="0.0 0 0.0" rgba="0 0 1 0.3" contype="1" conaffinity="1"/> <!-- blue -->
        <geom pos="0.5 0 0.068" quat="0.707107 0 0.707107 0" type="mesh" mesh="C86_convdec" contype="0" conaffinity="0"/>
        <geom pos="0.5 0 0.068" quat="0.707107 0 0.707107 0" type="mesh" mesh="D86-876.0001-H-proximal_convdec" contype="0" conaffinity="0"/> 
        <body name="joint2_distal" pos="0.564 0 0.0128" quat="0 1 0 0">
          <inertial pos="-0.0016138 0.00021641 0.047885" quat="0.719232 -0.0147998 -0.0123681 0.694502" mass="2.0708" diaginertia="0.0112523 0.0104514 0.00301799"/>
          <joint name="joint2_joint" damping="2.0" pos="0 0 0" axis="0 0 1" range="-4.7124 4.7124"/>
          <geom type="mesh" mesh="D86-876.0001-H-distal_convdec" contype="0" conaffinity="0"/>
          <geom type="mesh" mesh="C86_convdec" contype="0" conaffinity="0"/>
          <geom type="mesh" mesh="D86-876.0001-H-proximal_convdec" contype="0" conaffinity="0"/>
          <body name="joint3_distal" pos="0.0552 0 0.064" quat="0 0.707107 0 0.707107">
            <inertial pos="-0.00990896 -0.0127434 0.310235" quat="0.998596 -0.0505537 -0.0158118 0.00064432" mass="3.3876" diaginertia="0.186582 0.170909 0.020963"/>
            <joint name="joint3_joint" damping="2.0" pos="0 0 0" axis="0 0 1" range="-4.7124 4.7124"/>
            <geom type="mesh" mesh="D86-876.0001-H-distal_convdec" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="C86_convdec" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="I86-400_convdec" contype="0" conaffinity="0"/>
            <geom name="joint3_collision" type="sphere" size="0.1 0.1" pos="0 0 -0.07" rgba="1 1 0 0.3" contype="1" conaffinity="1"/> <!-- yellow -->
            <geom pos="0 0 0.4" quat="1 0 0 0" type="mesh" mesh="C86_convdec" contype="0" conaffinity="0"/>
            <geom pos="0 0 0.4" quat="1 0 0 0" type="mesh" mesh="D86-876.0001-H-proximal_convdec" contype="0" conaffinity="0"/> 
            <body name="joint4_distal" pos="0.0552 0 0.464" quat="0 0.707107 0 0.707107">
              <inertial pos="-0.0016138 0.00021641 0.047885" quat="0.719232 -0.0147998 -0.0123681 0.694502" mass="2.0708" diaginertia="0.0112523 0.0104514 0.00301799"/>
              <joint name="joint4_joint" damping="2.0" pos="0 0 0" axis="0 0 1" range="-4.7124 4.7124"/>
              <geom type="mesh" mesh="D86-876.0001-H-distal_convdec" contype="0" conaffinity="0"/>
              <geom type="mesh" mesh="C86_convdec" contype="0" conaffinity="0"/>
              <geom type="mesh" mesh="D86-876.0001-H-proximal_convdec" contype="0" conaffinity="0"/> 
              <geom name="joint4_collision" type="box" size="0.1 0.08 0.14" pos="-0.02 0 -0.02" rgba="1 0 1 0.3" contype="1" conaffinity="1"/> <!-- magenta -->
              <body name="joint5_distal" pos="0.0552 0 0.064" quat="0 0.707107 0 0.707107">
                <inertial pos="8.1887e-05 0.00021863 0.0169912" quat="0.996955 -0.00209442 0.00119539 -0.077939" mass="0.772831" diaginertia="0.00217087 0.00212511 0.000873867"/>
                <joint name="joint5_joint" damping="2.0" pos="0 0 0" axis="0 0 1" range="-4.7124 4.7124"/>
                <geom type="mesh" mesh="D86-876.0001-H-distal_convdec" contype="0" conaffinity="0"/>
                <geom type="mesh" mesh="C86_convdec" contype="0" conaffinity="0"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <!-- Self-collision sensors between non-adjacent robot parts -->
    <contact name="joint0_joint4_found" geom1="joint0_collision" geom2="joint4_collision" reduce="mindist" num="1" data="found"/>
    <contact name="joint1_joint4_found" geom1="joint1_collision" geom2="joint4_collision" reduce="mindist" num="1" data="found"/>
    <!-- Ground collision sensors -->
    <contact name="joint3_floor_found" geom1="joint3_collision" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="joint4_floor_found" geom1="joint4_collision" geom2="floor" reduce="mindist" num="1" data="found"/>
  </sensor>

  <actuator>
    <position name="joint0_joint_ctrl" joint="joint0_joint" kp="40" dampratio="1" ctrllimited="true" ctrlrange="-4.7124 4.7124"/>
    <position name="joint1_joint_ctrl" joint="joint1_joint" kp="100" dampratio="1" ctrllimited="true" ctrlrange="-4.7124 4.7124"/>
    <position name="joint2_joint_ctrl" joint="joint2_joint" kp="40" dampratio="1" ctrllimited="true" ctrlrange="-4.7124 4.7124"/>
    <position name="joint3_joint_ctrl" joint="joint3_joint" kp="40" dampratio="1" ctrllimited="true" ctrlrange="-4.7124 4.7124"/>
    <position name="joint4_joint_ctrl" joint="joint4_joint" kp="20" dampratio="1" ctrllimited="true" ctrlrange="-4.7124 4.7124"/>
    <position name="joint5_joint_ctrl" joint="joint5_joint" kp="20" dampratio="1" ctrllimited="true" ctrlrange="-4.7124 4.7124"/>
  </actuator>
</mujoco>
